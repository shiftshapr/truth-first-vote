# Copy to .env.local on the server. ecosystem.config.js loads it for PM2.
# Never commit real values.

# Postgres (one local database per box; tables are prefixed tf_)
TF_DATABASE_URL=postgresql://tf_prod:CHANGE_ME@127.0.0.1:5432/truthfirst

# Session cookie encryption: 64 hex chars (openssl rand -hex 32)
AUTH_SESSION_SECRET=

# Bootstrap admins (comma separated); more can be added in /admin
TF_ADMIN_EMAILS=daveed@bridgit.io

# Email via Resend (broadcasts, support replies, sign-up alerts)
RESEND_API_KEY=
TF_EMAIL_FROM=Truth First <hello@truthfirst.vote>
TF_SUPPORT_EMAIL=hello@truthfirst.vote
TF_ALERT_TO=daveed@bridgit.io

TF_PUBLIC_BASE=https://truthfirst.vote
